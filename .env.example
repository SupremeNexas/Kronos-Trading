# ==============================================================================
# Kronos — AI-Powered Market Intelligence
# Environment Configuration Template
# ==============================================================================

# Server & Runtime Configuration
PORT=7070
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-secure-random-secret-key-min-32-chars

# Database Configuration (PostgreSQL in production, SQLite fallback in local)
DATABASE_URL=postgresql://username:password@hostname:5432/kronos_db

# Frontend URL (For Backend CORS configuration)
FRONTEND_URL=https://your-kronos-frontend.vercel.app
NEXT_PUBLIC_API_URL=https://your-kronos-backend.onrender.com

# Market Data Feed Settings (live / mock)
MARKET_DATA_PROVIDER=mock
# TRADING_MODE: paper (simulated execution) or live
TRADING_MODE=paper
BROKER_PROVIDER=mock

# Risk Gate & Safety Limits
MAX_ORDER_VALUE=50000
MAX_POSITION_VALUE=100000
MAX_DAILY_LOSS=5000

# Kronos AI Forecasting & Foundation Model Settings
FORECAST_MODE=ai
DEFAULT_KRONOS_MODEL=kronos-small

# Optional LLM Integration for Research Reports (Optional)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_API=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3.2:3b

# External Market Data Provider
INFOWAY_API_KEY=your-infoway-api-key

# Alpaca Paper Trading Execution
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPACA_PAPER_TRADE=true
