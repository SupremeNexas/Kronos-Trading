{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kronos-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 3000,
      "autoPort": true,
      "url": "http://localhost:3000"
    },
    {
      "name": "kronos-webui",
      "runtimeExecutable": "./.venv/bin/python3",
      "runtimeArgs": [
        "webui/app.py"
      ],
      "port": 7070,
      "autoPort": true,
      "url": "http://localhost:7070"
    }
  ]
}
